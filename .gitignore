# ============================================================
# Celeste Android Port - repository-wide ignore rules
# ============================================================

# ------------------------------------------------------------
# Secrets, signing keys, and machine-specific configuration
# ------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties
local.properties
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Android / Gradle generated files
# ------------------------------------------------------------
.gradle/
**/.gradle/
build/
**/build/
captures/
.externalNativeBuild/
.cxx/
**/.cxx/
*.apk
*.ap_
*.aab
*.aar
*.dex
*.odex
*.vdex
*.prof
*.profm
output-metadata.json
manifest-merger-*.txt

# Keep the Gradle wrapper JAR if one is added.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------------------------
# Java / Kotlin generated files
# ------------------------------------------------------------
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.kotlin/
**/.kotlin/

# Keep source-controlled wrapper or explicitly vendored JARs.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------------------------
# .NET / C# generated files
# ------------------------------------------------------------
bin/
obj/
**/bin/
**/obj/
*.dll
*.pdb
*.deps.json
*.runtimeconfig.json
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
TestResults/
packages/
artifacts/
**/artifacts/

# Keep source project files and metadata.
!*.csproj
!*.sln
!metadata.yaml

# ------------------------------------------------------------
# Local SDKs, toolchains, dependency caches, and temporary tools
# ------------------------------------------------------------
tools/
**/tools/
.android/
.android-sdk/
.gradle-home/
.gradle-user-home/
.dotnet/
.dotnet-cli-home/
.nuget/
.nuget-wsl/
.emscripten_cache/
.emsdk/
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Generated, extracted, and temporary APK contents
# ------------------------------------------------------------
working/
probably not working/
probably-not-working/
extracted/
extracted-apk/
apk-extracted/
tmp/
temp/
.tmp/
**/.tmp-*/
**/tmp/
**/temp/

# Root-level files produced by APK extraction or patching.
#/AndroidManifest.xml is ignored only at the repository root.
#/app/src/main/AndroidManifest.xml remains tracked.
/AndroidManifest.xml
/classes.dex
/DebugProbesKt.bin
/resources.arsc
/META-INF/
/kotlin/
/org/
/com/
/res/

# Generated helper outputs at the repository root.
/RebuildApkWithStoredResources.class
/SignWithApkSig.class
/VerifyWithApkSig.class

# ------------------------------------------------------------
# Packaged runtime/game data that should not be committed
# ------------------------------------------------------------
data.data
**/data.data

# Large generated WebAssembly/runtime payloads.
**/_framework/*.wasm
**/_framework/*.wasm0
**/_framework/*.wasm1
**/_framework/*.wasm2
**/_framework/*.wasm3
**/_framework/*.wasm4
**/_framework/*.dat

# Commercial Celeste/Everest binaries and packaged mods.
**/assets/www/celeste/
**/assets/www/Mods/
**/assets/www/_framework/data/
**/assets/www/_framework/data.data
**/assets/www/**/*.dll
**/assets/www/**/*.pdb

# Generated copies produced inside Android build intermediates.
**/intermediates/
**/generated/
**/outputs/
**/compressed_assets/
**/merged_assets/
**/incremental/

# ------------------------------------------------------------
# Backups, logs, diagnostics, and scratch files
# ------------------------------------------------------------
*.log
*.bak
*.backup
*.orig
*.rej
*.tmp
*.temp
*.cache
*.lock
*.trace
*.dmp
*.stackdump
*.pid
*.socket
*.pre-portcredits.bak
file-tree.txt

# ------------------------------------------------------------
# IDE/editor files
# ------------------------------------------------------------
.idea/
*.iml
.vscode/
*.code-workspace
.project
.classpath
.settings/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Python caches used by helper scripts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ------------------------------------------------------------
# Local output folders
# ------------------------------------------------------------
dist/
out/
release/
releases/
diagnostics/
downloads/

# ------------------------------------------------------------
# local-only reference copies
# ------------------------------------------------------------
reference/
